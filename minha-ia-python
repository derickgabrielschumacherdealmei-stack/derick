import os
import streamlit as st
import google.generativeai as genai

# Configuração da Página
st.set_page_config(page_title="Impossível - IA Acadêmica", page_icon="⚡", layout="centered")

st.title("⚡ Impossível")
st.caption("Núcleo de inteligência artificial acadêmico e de alta precisão.")

# Configuração da Chave da API
api_key = os.getenv("GEMINI_API_KEY")

if not api_key:
    st.error("Erro Crítico: A chave de API do Gemini não foi configurada nas variáveis de ambiente do Streamlit.")
else:
    genai.configure(api_key=api_key)

    # Instruções de Sistema Acadêmicas e Rígidas
    SYSTEM_INSTRUCTION = """
    Você é o núcleo da inteligência artificial chamada "Impossível", desenvolvida para atuar com excelência absoluta em um AMBIENTE ESCOLAR E ACADÊMICO.
    DIRETRIZES:
    1. Postura profissional, formal, objetiva e estritamente educacional.
    2. Obediência literal a restrições e regras impostas.
    3. Precisão rigorosa e zero alucinações.
    """

    generation_config = {
        "temperature": 0.1, 
        "top_p": 0.9,
        "top_k": 30,
        "max_output_tokens": 8192,
    }

    model = genai.GenerativeModel(
        model_name="gemini-2.5-flash",
        generation_config=generation_config,
        system_instruction=SYSTEM_INSTRUCTION
    )

    # Inicializar histórico do chat na sessão
    if "chat_sessao" not in st.session_state:
        st.session_state.chat_sessao = model.start_chat(history=[])

    # Exibir histórico de mensagens na tela
    for mensagem in st.session_state.chat_sessao.history:
        role = "user" if mensagem.role == "user" else "assistant"
        with st.chat_message(role):
            st.markdown(mensagem.parts[0].text)

    # Entrada do usuário via chat visual
    if prompt_usuario := st.chat_input("Digite sua dúvida ou comando acadêmico..."):
        with st.chat_message("user"):
            st.markdown(prompt_usuario)

        with st.chat_message("assistant"):
            with st.spinner("Processando com precisão..."):
                try:
                    resposta = st.session_state.chat_sessao.send_message(prompt_usuario)
                    st.markdown(resposta.text)
                except Exception as e:
                    st.error(f"Erro de processamento: {e}")
